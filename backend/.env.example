# AI Provider: "anthropic" (직접 API) 또는 "bedrock" (AWS Bedrock)
AI_PROVIDER=anthropic

# --- Anthropic 직접 API ---
ANTHROPIC_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-sonnet-4-6-20250514

# --- AWS Bedrock ---
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# CLAUDE_MODEL_BEDROCK=us.anthropic.claude-sonnet-4-6-20250514-v1:0
#
# 방법 1: 명시적 키 (IAM User)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SESSION_TOKEN=optional-session-token
#
# 방법 2: AWS 기본 자격증명 체인 (위 키를 비워두면 자동 사용)
# - ~/.aws/credentials 프로파일
# - IAM Role (EC2/ECS)
# - AWS SSO (aws sso login)
# - 환경변수 (AWS_PROFILE 등)
